# GEMINI_API_KEY: Optional, injected by AI Studio if AI features are added.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PostgreSQL (Cloud SQL / local Postgres) credentials used via pg Pool Object Method
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_DB_NAME="dratva_workshop"
SQL_USER="postgres"
SQL_PASSWORD="change_me_password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="change_me_password"
# Установите "true", если подключаете облачную PostgreSQL (Neon, Supabase, Render)
SQL_SSL="false"
